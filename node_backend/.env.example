# ================================================================
# BẢN MẪU FILE .env CHO NODE BACKEND
# ----------------------------------------------------------------
# Cách dùng: copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# File .env thật KHÔNG được đưa lên GitHub (.gitignore đã chặn).
# File .env.example này CHỈ chứa giá trị giả, được phép đưa lên GitHub.
# ================================================================

# Chuỗi kết nối MongoDB Atlas (Atlas > Database > Connect > Drivers)
# BẮT BUỘC
MONGODB_URI=mongodb+srv://TEN_USER:MAT_KHAU@ten-cluster.xxxxx.mongodb.net/gym_churn?retryWrites=true&w=majority

# Chuỗi bí mật để ký token đăng nhập (JWT). Dài, ngẫu nhiên, không chia sẻ.
# BẮT BUỘC. Đổi chuỗi này thì mọi người phải đăng nhập lại.
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu

# Cổng chạy Node. Bỏ trống -> 3001. (Render tự đặt PORT, không cần khai báo)
PORT=3001

# Địa chỉ Flask AI. Bỏ trống -> http://127.0.0.1:5000
FLASK_URL=http://127.0.0.1:5000

# Tên miền frontend được phép gọi API, cách nhau bằng dấu phẩy.
# Bỏ trống -> cho phép mọi nơi (chỉ nên để trống khi chạy local).
# Ví dụ khi triển khai: CORS_ORIGIN=https://gym-churn.vercel.app
CORS_ORIGIN=